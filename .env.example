# QITAA Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server port (default: 3456)
PORT=3456

# Exchange rate: USD to SAR (default: 3.75)
USD_TO_SAR=3.75

# Customs duty rate on auto parts (default: 0.05 = 5%)
CUSTOMS_DUTY=0.05

# VAT rate (default: 0.15 = 15% Saudi VAT)
VAT=0.15

# Default commission markup (default: 0.20 = 20%)
COMMISSION=0.20

# Shipping rate per kg, USD (default: 18)
SHIPPING_PER_KG=18

# Puppeteer headless mode (default: true)
# Set to false to open a visible browser for manual review & payment
PUPPETEER_HEADLESS=true
